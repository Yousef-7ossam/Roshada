# Copy this file to .env and fill in real values. Never commit the real .env.

# ---- AI assistant ----
# The assistant runs server-side (appointments/services/ai). These keys belong
# to the API process; the Streamlit UI never reads them.
# Provider selector: groq | openai | gemini | local | mock | auto
# (auto prefers Groq, then OpenAI-compatible, then Gemini, by key presence).
# LLM_PROVIDER is accepted as an alias; AI_PROVIDER wins if both are set.
# An explicitly named provider is never silently swapped for another: if it has
# no key the assistant reports itself unavailable rather than sending patient
# messages to a company you did not choose. See docs/LLM_PROVIDERS.md.
#
# 'mock' answers offline and deterministically, for testing without spending a
# request. It is never chosen by 'auto' — a mock that won by default would
# serve invented text to someone asking a medical question.
AI_PROVIDER=auto
# Ceiling for one provider call, in seconds. Keep it below API_TIMEOUT so the
# backend finishes and stores the turn before the UI gives up on the request.
AI_TIMEOUT=25
# How long the UI waits for /api/chat/ask/. Must exceed AI_TIMEOUT: that request
# holds an LLM round-trip open inside it.
AI_REQUEST_TIMEOUT=60
# Groq (https://console.groq.com) — the configured provider. OpenAI-compatible,
# so it needs no extra client library.
# This file is committed: put a placeholder here and the real key in .env only.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=30
# Optional: GROQ_BASE_URL (default https://api.groq.com/openai/v1),
#           GROQ_MODEL_FALLBACKS (comma-separated, tried only if the model id
#           does not exist).
# OpenAI-compatible: OpenAI, TokenRouter, or ANY local model server.
# This file is committed — only ever put placeholders here, never a real key.
# Placeholder values like the ones below are detected and treated as "not
# configured", so a verbatim copy of this file disables the assistant cleanly
# instead of failing with a 401 at call time.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
# Optional: comma-separated models to try if OPENAI_MODEL does not exist.
# Only consulted for "model not found" — never for auth, quota or rate limits.
# OPENAI_MODEL_FALLBACKS=

# ---- Running a local model (Ollama / LM Studio / vLLM) ----
# They all serve the OpenAI chat-completions API, so no extra adapter is needed:
#   AI_PROVIDER=local
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=llama3.1
#   OPENAI_API_KEY=local-models-need-no-key   (any non-placeholder value)

# Google Gemini — reached over its REST API; no SDK required.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: GEMINI_MODEL (default gemini-2.0-flash), GEMINI_BASE_URL, GEMINI_TIMEOUT

# ---- Retrieval (RAG) ----
# The vector store is the application database — no extra service to run.
# Embedder: api | hashing | auto (default).
#   api     — semantic, via an OpenAI-compatible /embeddings endpoint.
#   hashing — offline, deterministic, LEXICAL ONLY (matches shared words, not
#             meaning). Used automatically when no embedding key is set, so
#             development and the test suite work with no credentials.
RAG_EMBEDDER=auto
# Falls back to OPENAI_API_KEY / OPENAI_BASE_URL when unset.
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=text-embedding-3-small
# Must match the model's real output width, or ingestion fails loudly.
RAG_EMBEDDING_DIMENSION=
# Changing any of these changes the vector space and requires a re-ingest.
RAG_HASHING_DIMENSION=2048
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
# Character budget for the context handed to the model.
RAG_CONTEXT_CHARS=4000
# Optional retrieval/context tuning (defaults shown):
# RAG_TOP_K=5              # passages retrieved per question
# RAG_MIN_SCORE=0.05       # below this a passage is noise and is not retrieved
# RAG_CONTEXT_CHUNKS=6     # hard ceiling on passages sent, regardless of chars
# RAG_DEDUPE_OVERLAP=0.8   # word overlap above which two passages from the same
#                          # document count as one (1.0 disables)
# RAG_TEMPERATURE=0.1

# Grounding for the patient assistant: on | off | auto (default auto).
#   auto — general medical questions are answered from the knowledge base when
#          it holds retrievable documents; everything else (your appointments,
#          using the product) goes to the normal assistant.
#   on   — always ground medical questions. With an empty corpus they are
#          answered "not in the approved sources" rather than from the model.
#   off  — no retrieval; the assistant answers as it did before.
# A medical question is never silently answered without sources: if retrieval
# or the provider fails, the assistant says so instead of improvising.
AI_GROUNDING=auto

# Tool calling for the assistant: on (default) | off.
# With it on, the assistant answers questions about the caller's own record by
# calling Roshada's services as that user, instead of saying it has no access.
# Booking and cancelling always require the person to agree in a later message.
AI_TOOLS=on

# ---- Django settings ----
# Generate a strong key, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=generate-a-long-random-secret-key

# DEBUG must be False in production. Set to True only for local development.
DJANGO_DEBUG=False

# Comma-separated hostnames this app is allowed to serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated https origins trusted for CSRF (production), e.g.:
#   https://app.example.com,https://api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Auth-token lifetime in hours. Tokens older than this are rejected and rotated
# on the next successful login. Set to 0 to disable expiry (not recommended).
AUTH_TOKEN_TTL_HOURS=24

# ---- PostgreSQL database (required) ----
# PostgreSQL is the only supported backend — there is no SQLite fallback, so the
# app will not start without a reachable server. Create the database first:
#   psql -U postgres -c "CREATE DATABASE roshada;"
# Never hardcode credentials; DB_PASSWORD is mandatory once DJANGO_DEBUG=False.
DB_NAME=roshada
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
# Optional tuning:
# DB_CONN_MAX_AGE=60            # seconds to reuse a connection (0 = per request)
# DB_CONNECT_TIMEOUT=10         # seconds to wait for a connection
# DB_STATEMENT_TIMEOUT_MS=30000 # kill any single statement after this (0 = off)
# DB_TEST_NAME=test_roshada     # database pytest creates and drops

# ---- Frontend ----
# Base URL the Streamlit client uses to reach the Django API.
API_BASE_URL=http://127.0.0.1:8000/api/
# Seconds before a frontend->API call is abandoned.
API_TIMEOUT=30

# ---- National-ID OCR ----
# Path to the Tesseract binary (the Docker image sets this to /usr/bin/tesseract).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# YOLO detector weights for the Egyptian National-ID fields. The OCR endpoint
# reports 503 (not configured) until this file exists.
# EGY_ID_WEIGHTS=egyId_weights.pt
# OCR_CONF=0.6
# OCR_IMGSZ=640

# ---- Logging ----
# APP_LOG_LEVEL=INFO
